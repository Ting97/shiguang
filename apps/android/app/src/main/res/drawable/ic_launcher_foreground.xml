<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌 logo「拾起一束光」：光束弯折落入承光弧（108dp 自适应图标画布，内容缩放至中心 66dp 安全区） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="120"
        android:pivotY="120">
        <!-- 光束辉光底层 -->
        <path
            android:pathData="M186,44 C150,60 108,84 96,132"
            android:strokeColor="#55F1C66B"
            android:strokeWidth="24"
            android:strokeLineCap="round" />
        <!-- 光束 -->
        <path
            android:pathData="M186,44 C150,60 108,84 96,132"
            android:strokeColor="#F1C66B"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <!-- 光源 -->
        <path
            android:pathData="M186,44 m-9,0 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0"
            android:fillColor="#FFF7E0" />
        <!-- 光点（被记下的瞬间） -->
        <path
            android:pathData="M150,72 m-3.2,0 a3.2,3.2 0 1 0 6.4,0 a3.2,3.2 0 1 0 -6.4,0"
            android:fillColor="#B3F1C66B" />
        <path
            android:pathData="M122,96 m-2.6,0 a2.6,2.6 0 1 0 5.2,0 a2.6,2.6 0 1 0 -5.2,0"
            android:fillColor="#80F1C66B" />
        <!-- 承光弧 -->
        <path
            android:pathData="M56,138 A62,62 0 0 0 184,138"
            android:strokeColor="#38BDF8"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <!-- 光落进弧里 -->
        <path
            android:pathData="M120,150 m-12,0 a12,12 0 1 0 24,0 a12,12 0 1 0 -24,0"
            android:fillColor="#F1C66B" />
        <path
            android:pathData="M120,150 m-5,0 a5,5 0 1 0 10,0 a5,5 0 1 0 -10,0"
            android:fillColor="#FFF7E0" />
    </group>
</vector>
