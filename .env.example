# 拾光复利 环境变量模板 —— 复制为 .env 后填写（.env 已被 gitignore）

# 数据库（本地 Docker：docker start shiguangri-pg）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiguangri

# 智谱开放平台 API Key（https://open.bigmodel.cn → API Keys）
ZHIPUAI_API_KEY=

# 可选：OpenAI 兼容端点（默认智谱官方）
# ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选：模型（默认 glm-4.7-flash，免费档，200K 上下文；实测 http://docs.bigmodel.cn 定价页）
# GLM_MODEL=glm-5.3-flash

# 可选：免费档持续限流(429)时的兜底模型（默认 glm-4-flash；置空禁用降级）
# GLM_FALLBACK_MODEL=glm-4-flash

# ---------- 账户体系（migrations/002） ----------
# 本地开发设为 1 可跳过登录（以开发用户身份运行）；生产环境严禁设置！
# AUTH_DISABLED=1

# 腾讯云短信（手机号验证码登录；未配置时验证码通道提示"审核中"，密码登录不受影响）
# 需：短信签名/模板审核通过（控制台 → 短信 → 国内消息）
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN=
# TENCENT_SMS_TEMPLATE_ID=

# ---------- 邮箱验证码（SMTP，未配置则邮箱注册退化为邀请码凭证、邮箱验证码登录不可用） ----------
EMAIL_SMTP_HOST=            # 如 smtp.qq.com / smtp.163.com
EMAIL_SMTP_PORT=465         # 465=SSL，587=STARTTLS
EMAIL_SMTP_USER=            # 发件邮箱账号
EMAIL_SMTP_PASS=            # SMTP 授权码（不是邮箱登录密码）
EMAIL_FROM=                 # 发件人显示，如 "拾光复利 <no-reply@ting97.cn>"

# ---------- 动态图片上传（REQ-001 R1） ----------
# 图片存储目录。生产必须放在发布交换目录之外（如 /opt/shiguangri_data/uploads），
# 否则双 tar 发版会连图片一起丢；开发缺省 apps/api 运行目录下 .uploads/
UPLOAD_DIR=

# ---------- AI 备链路（Jev / 传输形态，可选） ----------
# Jev 决策模型（未配置时仅 GLM 主链路）
# JEV_MODEL=jev-latest
# JEV_MODE=off            # off | shadow | on
# TYPESAFE_API_KEY=       # Jev 服务 Key
# TYPESAFE_BASE_URL=
# GLM_TRANSPORT=          # sdk | http（默认 sdk）
# GLM_ASR_MODEL=          # 语音识别模型（默认 glm-asr）

# ---------- 部署/运维（生产 systemd 环境注入，本地一般不用） ----------
# APP_ENV=production      # 生产判定（与 NODE_ENV 解耦，见 platform/config.ts）
# SETUP_TOKEN=            # 初始化门禁一次性令牌
# ALLOW_INSECURE=1        # 生产放行弱 DB 口令（仅临时应急）
# FFMPEG_PATH=            # ASR 音频转码兜底（安卓 m4a/webm → wav），如 /usr/bin/ffmpeg
# STATIC_DIR=             # web 静态导出目录（standalone 托管，默认 cwd/out）
# NEXT_PUBLIC_API_BASE=   # web 端 API 基址（同源部署时留空）
# EXPO_PUBLIC_API_BASE=   # Expo 原生端 API 基址

# ---------- 微信小程序通道（docs/15；两项任缺 = 通道未开通，登录侧 503） ----------
# WX_MINI_APPID=          # 小程序 AppID（微信公众平台 → 开发管理）
# WX_MINI_SECRET=         # 小程序 AppSecret
