# Unit: shiguangri —— Next.js standalone API（含 web 静态托管）
# 模板（REQ-009 FR-F3）：生产在 /etc/systemd/system/shiguangri.service，改动须同步本模板
[Unit]
Description=shiguangri API (Next.js standalone)
After=network.target postgresql.service

[Service]
Type=simple
# =生产实测（2026-10-22 核对 /etc/systemd/system/shiguangri.service）：
# env 经 EnvironmentFile 注入（Next standalone 不读版本根的 .env，@next/env 只看 server.js
# 所在目录；十六轮前模板无此行——按模板重建的服务会因缺 DATABASE_URL crash-loop）
WorkingDirectory=/opt/shiguangri/apps/api
EnvironmentFile=/opt/shiguangri/.env
ExecStart=/usr/local/shiguangri-runtime/bin/node server.js
Restart=always
RestartSec=3
# 上传目录在版本目录外（数据与代码分离，发布/回滚不动数据）
Environment=UPLOAD_DIR=/opt/shiguangri_data/uploads
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
